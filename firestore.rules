rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Professional validation
    function isValidProfessional(data) {
      return data.keys().hasAll(['userId', 'name', 'title', 'createdAt', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
             (data.get('bio', '') is string) && data.get('bio', '').size() <= 2000 &&
             (data.get('skills', []) is list) && data.get('skills', []).size() <= 20 &&
             (data.get('skills', []).size() == 0 || data.get('skills', [])[0] is string) &&
             (data.get('contactEmail', '') is string) && data.get('contactEmail', '').size() <= 150 &&
             (data.get('contactPhone', '') is string) && data.get('contactPhone', '').size() <= 50 &&
             (data.get('linkedin', '') is string) && data.get('linkedin', '').size() <= 255;
    }

    match /professionals/{professionalId} {
      allow get: if true;
      allow list: if true;
      
      allow create: if isSignedIn() &&
                    isValidId(professionalId) &&
                    professionalId == request.auth.uid &&
                    isValidProfessional(incoming()) &&
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time;
                    
      allow update: if isSignedIn() &&
                    isValidId(professionalId) &&
                    isOwner(existing().userId) &&
                    isValidProfessional(incoming()) &&
                    incoming().userId == existing().userId &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().updatedAt == request.time &&
                    // Ensure only allowed keys and updated fields
                    incoming().diff(existing()).affectedKeys().hasOnly(['name', 'title', 'bio', 'skills', 'contactEmail', 'contactPhone', 'linkedin', 'updatedAt']);
                    
      allow delete: if isSignedIn() && isValidId(professionalId) && isOwner(existing().userId);
    }
    
    // Inquiry validation
    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'email', 'idea', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
             data.idea is string && data.idea.size() > 0 && data.idea.size() <= 5000 &&
             (data.get('userId', '') is string) && data.get('userId', '').size() <= 128 &&
             (data.get('phone', '') is string) && data.get('phone', '').size() <= 50 &&
             (data.get('businessName', '') is string) && data.get('businessName', '').size() <= 150;
    }

    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) &&
                    isValidInquiry(incoming()) &&
                    (
                     incoming().get('userId', '') == '' || 
                     (isSignedIn() && incoming().userId == request.auth.uid)
                    ) &&
                    incoming().createdAt == request.time;
    }
  }
}
